{
  "name": "opencode-github-review-queue",
  "version": "0.6.0",
  "description": "Pending GitHub review requests for OpenCode TUI and Desktop",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andremarques94/opencode-github-review-queue.git"
  },
  "homepage": "https://github.com/andremarques94/opencode-github-review-queue#readme",
  "bugs": {
    "url": "https://github.com/andremarques94/opencode-github-review-queue/issues"
  },
  "keywords": [
    "opencode",
    "github",
    "pull-request",
    "code-review",
    "plugin"
  ],
  "packageManager": "pnpm@12.18.0",
  "exports": {
    ".": "./src/server/index.ts",
    "./tui": "./src/ui/tui/index.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/shared/rpc.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "lint": "biome check src test vite.config.ts vitest.config.ts",
    "prepack": "pnpm build",
    "prepare": "husky",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{cjs,js,json,jsonc,jsx,mjs,ts,tsx}": "biome check --write --no-errors-on-unmatched"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.0",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/node": "24.19.2",
    "fallow": "3.42.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "solid-js": "1.9.19",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vite-plugin-solid": "2.11.15",
    "vitest": "5.1.0"
  }
}
