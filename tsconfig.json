{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
